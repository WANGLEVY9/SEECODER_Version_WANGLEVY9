# Copy this file to .env or export the variables in your shell. Never commit real keys.
SEECODER_API_KEY=
SEECODER_BASE_URL=https://api.deepseek.com
SEECODER_MODEL=deepseek-v4-flash
# P0 uses non-thinking mode for stable multi-round tool calls. P1 will add
# optional reasoning-content preservation before enabling DeepSeek thinking mode.
SEECODER_THINKING_MODE=disabled
SEECODER_REASONING_EFFORT=high
# `restricted` accepts a small allowlist of argv-based test/build/format/read-only Git commands.
# `host_shell` is opt-in and remains a non-sandboxed legacy compatibility mode.
SEECODER_EXECUTION_MODE=restricted
# This is a safety ceiling. The runner retains independent model, command, and
# whole-task timeouts, so most tasks finish far below this value.
SEECODER_MAX_STEPS=10000
# Maximum wait for one provider request, in seconds (5-900).
SEECODER_MODEL_TIMEOUT_S=120
# auto: run tools freely; plan: inspect only and propose a plan; ask: confirm mutations before applying.
SEECODER_MODE=auto
# 1 enables model-driven context compaction when history overflows the character budget.
SEECODER_COMPACTION=0
